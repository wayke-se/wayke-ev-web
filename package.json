{
  "name": "@wayke-se/ev-web",
  "version": "0.0.1",
  "description": "Wayke Electric Vehicle Web",
  "module": "dist/index.mjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "node ./esbuild/start.js",
    "build": "npm run clean && node ./esbuild/lib.js && node ./esbuild/cdn.js",
    "clean": "rimraf build && rimraf dist && rimraf dist-cdn",
    "test": "npm run lint && npm run typecheck",
    "typecheck": "tsc -noEmit",
    "typecheck:watch": "tsc -noEmit -watch",
    "lint": "eslint --ext .ts,.js 'src'",
    "lint:fix": "eslint --ext .ts,.js 'src' --fix",
    "stylelint": "stylelint '**/*.scss'",
    "prepare": "husky install",
    "clip": "node ./esbuild/clip-ui.js && node ./clip-ui/start.js"
  },
  "author": "Wayke",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wayke-se/wayke-ev-web/issues"
  },
  "homepage": "https://github.com/wayke-se/wayke-ev-web#readme",
  "devDependencies": {
    "@ourstudio/clip-ui": "^0.0.8",
    "@types/node": "^17.0.18",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "esbuild": "^0.15.5",
    "esbuild-sass-plugin": "^2.2.3",
    "eslint": "^8.9.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "husky": "^8.0.1",
    "npm-dts": "^1.3.11",
    "prettier": "^2.5.1",
    "rimraf": "^3.0.2",
    "stylelint": "^14.5.1",
    "stylelint-config-prettier-scss": "^0.0.1",
    "stylelint-config-standard-scss": "^5.0.0",
    "typescript": "^4.5.5"
  },
  "files": [
    "dist"
  ]
}
